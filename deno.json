{
  "imports": {
    "@std/text": "jsr:@std/text@^1.0.19",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.0/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "markdown-it-link-attributes": "npm:markdown-it-link-attributes@^4.0.1"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "serve": "deno task lume -s"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "unstable": [
    "temporal",
    "fmt-component"
  ],
  "fmt": {
    "exclude": [
      "./src/public/smol.css",
      "./src/public/smol-v2.css"
    ]
  }
}
